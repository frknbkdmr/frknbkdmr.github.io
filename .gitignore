# Build output and Quarto's working state.
_site/
.quarto/
**/*.quarto_ipynb
# Quarto stages site_libs/ and the rendered .html next to their sources and
# then moves them into _site/. A render that dies partway leaves both behind,
# and the *.html rule below already covers its half. Without this line a later
# `git add -A` commits bootstrap and the quarto JS into the repo root.
site_libs/

# Rendered pages are build output, but head.html is a source include that
# Quarto injects, so it has to stay tracked. Add an exception here for any
# other hand-written HTML (a 404 page, a search-console verification file) —
# without one it is ignored silently and never gets committed.
*.html
!head.html
# Search-engine ownership checks. Keep these exceptions: the rule above would
# otherwise swallow them silently and the verification would never deploy.
# Note there are no inline comments in .gitignore — a trailing # becomes part
# of the pattern.
!yandex_*.html
!google*.html

/.quarto/

# TTFs make-og-image.py downloads to draw the card. Fetched on demand, and
# large enough that there is no reason to carry them in the repo.
.ttf-cache/

# Quarto drops this next to the project when a Sass compile fails.
_quarto_internal_scss_error.scss

# Internal working notes, not site source. STIL.md quotes private writing
# samples; this repo is public, so it must never be pushed.
SITE_AUDIT_REPORT.md
STIL.md

# Python bytecode from post-render.py and publish.py.
__pycache__/
